DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# Only needed if your DashScope account is on the international (Singapore)
# side rather than mainland — find it in the Model Studio console (click
# your avatar in the top-right corner). Leave blank for a mainland account.
DASHSCOPE_WORKSPACE_ID=

ELEVENLABS_API_KEY=sk-your-key-here

# Optional: ElevenLabs voice IDs (defaults used if left blank)
ELEVENLABS_VOICE_ID_ZH=
ELEVENLABS_VOICE_ID_EN=

# Amap (高德地图) Web服务API key, from lbs.amap.com — needed for
# get_transit_directions. Without it, the tool degrades gracefully and the
# agent just says it doesn't have a route right now.
AMAP_API_KEY=

# Supabase project (auth, Postgres storage for logs/notes/profiles, and
# photo uploads) — from your project's Settings > API page.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key — server-side only, bypasses row-level security.
# Never expose this one to the frontend.
SUPABASE_SECRET_KEY=
